{
  "name": "emadunan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "find . -type d \\( -name node_modules -o -name dist -o -name build -o -name .turbo -o -name .next -o -name .vite \\) -prune -exec rm -rf {} + && rm -f .eslintcache"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.8.1",
    "cpx": "^1.5.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.46.1"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^20.17.0 || >=22.9.0",
    "npm": ">=11"
  },
  "version": "0.0.1"
}
